[core]
	repositoryformatversion = 1
	filemode = true
	bare = false
	logallrefupdates = true
[pack]
	writereverseindex = false
[remote "origin"]
	url = https://github.com/natiabril77-hue/latitud-app.git
	fetch = +refs/heads/*:refs/remotes/origin/*
	promisor = true
	partialclonefilter = blob:limit=1024
[branch "main"]
	remote = origin
	merge = refs/heads/main
